; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Idle Space Company"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[autoload]

EventBus="*res://autoload/event_bus.gd"
GameState="*res://autoload/game_state.gd"
SaveService="*res://autoload/save_service.gd"
TimeService="*res://autoload/time_service.gd"
AdService="*res://autoload/ad_service.gd"
Analytics="*res://autoload/analytics.gd"
AudioService="*res://autoload/audio_service.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[internationalization]

locale/translations=PackedStringArray("res://locale/strings.en.translation", "res://locale/strings_es.es.translation", "res://locale/strings_pt_BR.pt_BR.translation", "res://locale/strings_fr.fr.translation", "res://locale/strings_de.de.translation", "res://locale/strings_id.id.translation", "res://locale/strings_tr.tr.translation", "res://locale/strings_ru.ru.translation")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
